# Normalize text files to LF in Git
* text=auto

# Research source code and documentation
*.py text eol=lf
*.cu text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Preserve binary figures
*.png binary
*.pdf binary

# Preserve exact GPU disassembly fixture bytes
*.sass binary
